# CRM Showcase — .env template
#
# This file is a shape template only. Copy to `.env.local` and fill in real values.
# `.env.local` (and any other `.env.*` except this file) is git-ignored.
#
# Real tenant, environment, and credential values NEVER live in Git.

# --- Demo tenant (Microsoft-provided sandbox) ---
DEMO_TENANT_DOMAIN=
DEMO_TENANT_ID=

# --- Power Platform environments ---
# DEV = developer environment, Dynamics 365 Foundation + custom (unmanaged)
DEV_ENV_URL=
DEV_ENV_ID=
DEV_ORG_ID=

# TEST = integration testing / demo environment (managed solutions)
TEST_ENV_URL=
TEST_ENV_ID=
TEST_ORG_ID=

# Optional isolated prototype source used only for local intake.
PROTOTYPE_SOURCE_ENV_URL=
PROTOTYPE_SOURCE_ORG_NAME=

# --- Auth ---
# The showcase does NOT store an admin UPN or password anywhere.
# GitHub Actions authenticate via Entra ID workload identity federation (OIDC).
# See docs/adr/ADR-0002-oidc-federation-for-github-actions-to-entra.md.
#
# For interactive local dev, sign in with:  az login  (or the Power Platform CLI)
# No values below in Git. These names exist only so scripts can read them locally.
AZURE_CLIENT_ID=
AZURE_TENANT_ID=
# NOTE: never set AZURE_CLIENT_SECRET here. Use OIDC or `az login`.
